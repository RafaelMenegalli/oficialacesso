    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "eslint": "^9",
