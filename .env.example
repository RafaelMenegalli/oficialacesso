# Copy to .env (local) or set in the Hostinger panel (production). Never commit real values.

# --- Video ----------------------------------------------------------------
# Optional remote URL for the VSL video, read at BUILD time; empty = local file, then the hosted copy.
NEXT_PUBLIC_VSL_VIDEO_URL=

# --- Database -------------------------------------------------------------
# PostgreSQL connection string (required). Production: the Neon URL. Local: `npm run db:dev`.
DATABASE_URL=
# Only for `prisma migrate dev` locally: the shadow database URL printed by `npm run db:dev`.
SHADOW_DATABASE_URL=

# --- Evolution API (self-hosted WhatsApp, Baileys) ------------------------
# Public HTTPS URL of the Evolution server behind the reverse proxy (required).
EVOLUTION_BASE_URL=https://evolution.oficialacesso.site
# GLOBAL key = the server's AUTHENTICATION_API_KEY; instance lifecycle + webhook config (required).
EVOLUTION_API_KEY=
# Instance name (default shown).
EVOLUTION_INSTANCE_NAME=sensitiva
# INSTANCE token; sends messages. Written here by `npm run whatsapp:setup` (required).
EVOLUTION_INSTANCE_TOKEN=
# Random secret (≥32 chars, `openssl rand -hex 32`), last segment of the webhook URL (required).
EVOLUTION_WEBHOOK_SECRET=
# Public URL of this app; the setup script builds the webhook URL from it.
APP_URL=https://oficialacesso.site

# --- Message ----------------------------------------------------------------
# Link sent in the WhatsApp message (default shown).
NEXT_PUBLIC_VSL_URL=https://oficialacesso.site/vsl
# Business number, digits only, target of the wa.me fallback link (default shown).
WHATSAPP_BUSINESS_PHONE=5519981630656

# --- Logging ------------------------------------------------------------------
# debug | info | warn | error (default info). debug logs message bodies — keep it off in production.
LOG_LEVEL=info
