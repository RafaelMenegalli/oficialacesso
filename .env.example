# Copy to .env (local) or set in the Hostinger panel (production). Never commit real values.

# --- Video ----------------------------------------------------------------
# Optional remote URL for the VSL video (recommended in production); empty = /public/assets/vsl-video.mp4.
NEXT_PUBLIC_VSL_VIDEO_URL=

# --- Database -------------------------------------------------------------
# PostgreSQL connection string (required). Local: run `npm run db:dev` and use the TCP URL it prints.
DATABASE_URL=
# Only for `prisma migrate dev` locally: the shadow database URL printed by `npm run db:dev`.
SHADOW_DATABASE_URL=

# --- Omni Z-API (official WhatsApp API, CoEX) — values from app.omni.z-api.io -----
# API base URL (default shown).
ZAPI_BASE_URL=https://api.omni.z-api.io
# Secret Key from the panel's Segurança menu; sent as "Authorization: Bearer". Required. (Replaces Z-API's Client-Token.)
ZAPI_SECRET_KEY=
# Channel id of the CoEX number (Omni's name for the old "instance id"). Required.
ZAPI_CHANNEL_ID=
# WhatsApp Business Account id; templates live here (GET /whatsapp/businesses lists it). Required.
ZAPI_WABA_ID=
# Random string you generate (≥32 chars, e.g. `openssl rand -hex 32`); the webhook must send it in x-webhook-secret. Required.
ZAPI_WEBHOOK_SECRET=
# HMAC secret returned once by `npm run whatsapp:webhook` (signing: true); written to .env automatically. Optional but recommended.
ZAPI_WEBHOOK_SIGNING_SECRET=

# --- Template ---------------------------------------------------------------
# Approved MARKETING template name (default shown).
WHATSAPP_TEMPLATE_NAME=simpatia_acesso_imediato
# Template language (default shown).
WHATSAPP_TEMPLATE_LANG=pt_BR
# Business number, digits only, used for the wa.me fallback link (default shown).
WHATSAPP_BUSINESS_PHONE=5519981630656
# Link in the template's "Assistir agora" button (used when creating the template).
NEXT_PUBLIC_VSL_URL=https://oficialacesso.site/vsl

# --- Logging ------------------------------------------------------------------
# debug | info | warn | error (default info). debug logs message bodies — keep it off in production.
LOG_LEVEL=info
