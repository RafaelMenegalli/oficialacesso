// Lead capture + WhatsApp delivery through Evolution API (Baileys).
// See docs/WHATSAPP.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  captured
  sent
  delivered
  read
  failed
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageKind {
  text
  status
}

/// A visitor who submitted the VSL lead-capture modal.
/// TODO(LGPD): retention policy is an open decision for the owner — how long
/// leads (name, phone, consent IP) are kept and how deletion requests are handled.
model Lead {
  id             String     @id @default(cuid())
  name           String
  /// E.164 with plus, e.g. "+5519981630656".
  phone          String     @unique
  source         String     @default("vsl")
  status         LeadStatus @default(captured)
  consentAt      DateTime
  consentIp      String?
  /// WhatsApp message id (key.id) of the message we sent.
  waMessageId    String?
  firstInboundAt DateTime?
  /// Provider error of the last failed send/delivery.
  replyError     String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  messages MessageLog[]

  @@index([phone])
  @@index([waMessageId])
}

/// Every outbound send and inbound/status webhook. `waMessageId` is the
/// idempotency key: replayed webhooks hit the unique constraint and are skipped.
model MessageLog {
  id          String           @id @default(cuid())
  leadId      String?
  lead        Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  direction   MessageDirection
  /// WhatsApp message id, or for status webhooks "<messageId>:<STATUS>".
  waMessageId String           @unique
  kind        MessageKind
  body        String?
  status      String?
  errorCode   String?
  createdAt   DateTime         @default(now())

  @@index([leadId])
}
