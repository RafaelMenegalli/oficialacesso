# Environment for docker-compose.evolution.yml (the Evolution API server).
# Copy to .env.evolution on the VPS and fill every value. Never commit the real file.

# Public hostname served by Caddy over HTTPS. Point an A record at the VPS first.
EVOLUTION_DOMAIN=evolution.oficialacesso.site

# GLOBAL API key. Required. Used for instance lifecycle (create, list, connect,
# delete, logout) and webhook configuration. Generate: openssl rand -hex 32
# The Next.js app stores the same value as EVOLUTION_API_KEY.
AUTHENTICATION_API_KEY=

# Let fetchInstances return each instance's token (npm run whatsapp:setup reads it).
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# Evolution's own Postgres (inside the stack; not the app's Neon database).
POSTGRES_USER=evolution
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=evolution

# Name shown on the phone under "Dispositivos conectados".
CONFIG_SESSION_PHONE_CLIENT=Sensitiva
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30

# Webhooks are configured per instance by the setup script, not globally.
WEBHOOK_GLOBAL_ENABLED=false

# Keep instances when they disconnect (rescan instead of recreating).
DEL_INSTANCE=false

# Message storage inside Evolution's DB. Contains personal data (LGPD) — the
# app keeps its own copy, so new-message storage could be turned off later.
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true

LOG_LEVEL=ERROR,WARN,INFO
TELEMETRY_ENABLED=false
LANGUAGE=pt-BR
